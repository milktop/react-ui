// The whole project, type-checked by `npm run check` (nothing emitted).
// tsconfig.build.json compiles src/ for publishing.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    // Examples import the library by its package name, as an app would.
    "paths": { "@milktop/react-ui": ["./src/index.ts"] }
  },
  "include": ["src", "playground"],
  "exclude": ["playground/dist"]
}
