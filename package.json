{
  "name": "@milktop/react-ui",
  "version": "0.2.0",
  "description": "React components on Ark UI (Zag state machines), with imba-ui's API and design",
  "license": "MIT",
  "author": "André Goldstein",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milktop/react-ui.git"
  },
  "homepage": "https://github.com/milktop/react-ui#readme",
  "bugs": {
    "url": "https://github.com/milktop/react-ui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "ark-ui",
    "zag",
    "design-system"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/icons.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite playground --port 5194",
    "build": "vite build playground",
    "build:lib": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/after-tsc.js",
    "check": "tsc && eslint src playground",
    "prepublishOnly": "npm run build:lib",
    "preversion": "npm run check && npm run build:lib",
    "postversion": "git push --follow-tags",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "release:beta": "npm version prerelease --preid beta"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@internationalized/date": "^3.12.4",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@zag-js/date-utils": "^1.45.0",
    "@zag-js/file-utils": "^1.45.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "iconify-icon": "^3.0.3"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  }
}
